# ---------------------------------------------------------------------------
# AI providers
# ---------------------------------------------------------------------------
# Gemini powers the camera doubt solver (vision) and is the primary text model.
# Get one free at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Groq is the text fallback when Gemini is unavailable or rate-limited.
# https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# ---------------------------------------------------------------------------
# Supabase (optional — the app works fully signed out, without caching)
# ---------------------------------------------------------------------------
# Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Used to write the shared chapter cache and bypass RLS.
# NEVER expose this with a NEXT_PUBLIC_ prefix.
SUPABASE_SERVICE_ROLE_KEY=
